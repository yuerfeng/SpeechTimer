<Window x:Class="SpeechTimer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SpeechTimer"
        mc:Ignorable="d"
        Title="演讲倒计时器"
        Width="380"
        Height="420"
        MinWidth="380"
        MinHeight="420"
        Background="#151520"
        Foreground="White"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei, Segoe UI, Arial"
        ResizeMode="CanMinimize"
        Icon="Assets/main.ico">

    <Window.Resources>
        <Style x:Key="TimeInputStyle" TargetType="TextBox">
            <Setter Property="Width" Value="60"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#1E1E2E"/>
            <Setter Property="Foreground" Value="#EAEAEA"/>
            <Setter Property="BorderBrush" Value="#2A2A3E"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CaretBrush" Value="#00B4FF"/>
            <Setter Property="SelectionBrush" Value="#00B4FF"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          Focusable="false"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#00B4FF"/>
                    <Setter Property="Background" Value="#252540"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="90"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.9"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Opacity" Value="0.75"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.35"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PresetButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="68"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="#999999"/>
            <Setter Property="Background" Value="#1E1E2E"/>
            <Setter Property="BorderBrush" Value="#2A2A3E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2A2A3E"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="BorderBrush" Value="#00B4FF"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#00B4FF"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 时间显示 -->
        <Border Grid.Row="0" Background="#1E1E2E" CornerRadius="12" Padding="20,12"
                BorderBrush="#2A2A3E" BorderThickness="1" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock x:Name="TimeDisplay" Text="00:00:00"
                           FontSize="56" FontWeight="Bold"
                           Foreground="#00B4FF" TextAlignment="Center"
                           FontFamily="Consolas, Microsoft YaHei"/>
                <TextBlock x:Name="StatusDisplay" Text="请设置倒计时时间"
                           FontSize="12" Foreground="#666666"
                           TextAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- 设置时间 -->
        <Border Grid.Row="1" Background="#1E1E2E" CornerRadius="10" Padding="16,10"
                BorderBrush="#2A2A3E" BorderThickness="1" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                    <TextBlock Text="时" FontSize="10" Foreground="#555555"
                               TextAlignment="Center" Margin="0,0,0,4"/>
                    <TextBox x:Name="HoursInput" Text="0"
                             Style="{StaticResource TimeInputStyle}"/>
                </StackPanel>

                <TextBlock Grid.Column="1" Text=":" FontSize="18" FontWeight="Bold"
                           Foreground="#333333" VerticalAlignment="Bottom"
                           Margin="8,0,8,6"/>

                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                    <TextBlock Text="分" FontSize="10" Foreground="#555555"
                               TextAlignment="Center" Margin="0,0,0,4"/>
                    <TextBox x:Name="MinutesInput" Text="10"
                             Style="{StaticResource TimeInputStyle}"/>
                </StackPanel>

                <TextBlock Grid.Column="3" Text=":" FontSize="18" FontWeight="Bold"
                           Foreground="#333333" VerticalAlignment="Bottom"
                           Margin="8,0,8,6"/>

                <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                    <TextBlock Text="秒" FontSize="10" Foreground="#555555"
                               TextAlignment="Center" Margin="0,0,0,4"/>
                    <TextBox x:Name="SecondsInput" Text="0"
                             Style="{StaticResource TimeInputStyle}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 按钮控制 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
            <Button x:Name="StartButton" Content="&#x25B6; 开始"
                    Style="{StaticResource ActionButtonStyle}"
                    Click="StartButton_Click" Background="#00B4FF"
                    Margin="0,0,10,0"/>
            <Button x:Name="PauseButton" Content="&#x23F8; 暂停"
                    Style="{StaticResource ActionButtonStyle}"
                    Click="PauseButton_Click" IsEnabled="False"
                    Background="#E94560" Margin="0,0,10,0"/>
            <Button x:Name="ResetButton" Content="&#x21BB; 重置"
                    Style="{StaticResource ActionButtonStyle}"
                    Click="ResetButton_Click" Background="#533483"/>
        </StackPanel>

        <!-- 预设时间 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
            <Button Content="5分钟" Style="{StaticResource PresetButtonStyle}"
                    Click="PresetButton_Click" Tag="0:5:0" Margin="0,0,8,0"/>
            <Button Content="10分钟" Style="{StaticResource PresetButtonStyle}"
                    Click="PresetButton_Click" Tag="0:10:0" Margin="0,0,8,0"/>
            <Button Content="15分钟" Style="{StaticResource PresetButtonStyle}"
                    Click="PresetButton_Click" Tag="0:15:0" Margin="0,0,8,0"/>
            <Button Content="30分钟" Style="{StaticResource PresetButtonStyle}"
                    Click="PresetButton_Click" Tag="0:30:0"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center">
            <CheckBox x:Name="SoundCheckBox"
                      Content="播放提示音"
                      Foreground="#888888"
                      FontSize="12"
                      VerticalContentAlignment="Center"
                      Margin="0,0,24,0"/>
            <CheckBox x:Name="OvertimeCheckBox"
                      Content="允许超时"
                      Foreground="#888888"
                      FontSize="12"
                      VerticalContentAlignment="Center"
                      IsChecked="True"/>
        </StackPanel>
    </Grid>
</Window>